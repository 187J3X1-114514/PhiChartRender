{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Phigros Simulator Plus",
	"version": "0.1.3",
	"identifier": "dev.phisimplus.tauri",
	"build": {
		"frontendDist": "../packages/phigros/dist",
		"devUrl": "http://localhost:5173/",
		"beforeDevCommand": "pnpm run dev:web",
		"beforeBuildCommand": "pnpm run build:web"
	},
	"app": {
		"windows": [
			{
				"title": "phigros_sim_plus",
				"width": 1280,
				"height": 720,
				"resizable": true,
				"fullscreen": false,
				"transparent": true
			}
		],
		"security": {
			"csp": null,
			"headers": {
				"Cross-Origin-Opener-Policy": "same-origin",
				"Cross-Origin-Embedder-Policy": "require-corp"
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"windows": {
			"webviewInstallMode": {
				"type": "embedBootstrapper"
			}
		}
	}
}